# Copie para .env.local (teste local) ou cadastre no Vercel (Settings > Environment Variables).
# Nunca envie valores reais para o GitHub.

# Chave da API do HelpRex (não é necessária com DEMO=1)
HELPREX_API_KEY=
# Endereço do painel do HelpRex da sua empresa, usado nos links dos chamados
HELPREX_PAINEL_URL=https://suaempresa.helprex.com

# Segredo que assina o cookie de sessão (texto longo e aleatório)
SESSION_SECRET=

# Primeiro administrador (criado no 1º login, com troca de senha obrigatória)
ADMIN_LOGIN=admin
ADMIN_NOME=Administrador
ADMIN_SENHA_INICIAL=
ADMIN_HELPREX_ID=

# Meta diária padrão (cada usuário pode ter a sua no Admin)
META=10

# 1 = dados fictícios, sem HelpRex, com o visitante demo / demo123
DEMO=

# Banco (Upstash Redis). No Vercel vêm sozinhas ao conectar o Upstash ao projeto.
KV_REST_API_URL=
KV_REST_API_TOKEN=
